# crabucate.de — replicates the behaviour GitHub Pages provided out of the box.

ErrorDocument 404 /404.html

RewriteEngine On

# Force HTTPS (GitHub Pages had "Enforce HTTPS" enabled).
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^(.*)$ https://crabucate.de/$1 [R=301,L]

# www -> apex, matching the canonical URLs in the page <head>.
RewriteCond %{HTTP_HOST} ^www\.crabucate\.de$ [NC]
RewriteRule ^(.*)$ https://crabucate.de/$1 [R=301,L]

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css image/svg+xml application/javascript
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/html "access plus 10 minutes"
  # /assets/ hat keine Versionierung im Dateinamen, weil es keinen Build-Schritt
  # gibt. Eine Stunde haelt die Auslieferung schnell, ohne dass eine Korrektur
  # tagelang bei Besuchern haengen bleibt.
  ExpiresByType text/css "access plus 1 hour"
  ExpiresByType application/javascript "access plus 1 hour"
</IfModule>
